<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovelTranslator.App.App"
             xmlns:local="using:NovelTranslator.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="MainBgBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="EditorBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="RaisedBgBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E4E4E7" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#171717" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#525252" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#737373" />
        <SolidColorBrush x:Key="BadgeBgBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource MainBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma, avares://NovelTranslator.App/Assets/Fonts#Tahoma, sans-serif" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma, avares://NovelTranslator.App/Assets/Fonts#Tahoma, sans-serif" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource RaisedBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource RaisedBgBrush}" />
            <Setter Property="Foreground" Value="#E5484D" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Border.keycap">
            <Setter Property="Background" Value="{DynamicResource MainBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,1" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma, avares://NovelTranslator.App/Assets/Fonts#Tahoma, sans-serif" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Application.Styles>
</Application>
