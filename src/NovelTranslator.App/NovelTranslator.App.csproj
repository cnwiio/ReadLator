<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>2.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- แก้ไข Roslyn analyzer conflict ใน .NET 10 SDK -->
  <Target Name="FilterCommunityToolkitAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(FileName)' == 'CommunityToolkit.Mvvm.SourceGenerators' and !$([System.String]::Copy('%(Analyzer.Identity)').Contains('roslyn4.12'))" />
      <Analyzer Remove="@(Analyzer)" Condition="'%(FileName)' == 'CommunityToolkit.Mvvm.CodeFixers' and !$([System.String]::Copy('%(Analyzer.Identity)').Contains('roslyn4.12'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\NovelTranslator.Core\NovelTranslator.Core.csproj" />
  </ItemGroup>
</Project>
