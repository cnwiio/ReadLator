<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:NovelTranslator.App.Controls"
        x:Class="NovelTranslator.App.Views.BrowserImportWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="เบราว์เซอร์ดึงเนื้อหา (โหมดไม่ระบุตัวตน)"
        Width="1120"
        Height="760"
        MinWidth="920"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBgBrush}">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- แถบเครื่องมือด้านบน -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BackButton" Classes="ghost" Width="32" Height="32" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            IsEnabled="False" ToolTip.Tip="ย้อนกลับ" Click="OnBackClicked">
                        <Path Data="M19,12 L5,12 M12,19 L5,12 L12,5" Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="ForwardButton" Classes="ghost" Width="32" Height="32" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            IsEnabled="False" ToolTip.Tip="ไปข้างหน้า" Click="OnForwardClicked">
                        <Path Data="M5,12 L19,12 M12,5 L19,12 L12,19" Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="ReloadButton" Classes="ghost" Width="32" Height="32" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="โหลดหน้าใหม่" Click="OnReloadClicked">
                        <Path Data="M20,12 A8,8 0 1,1 17.66,6.34 M20,4 L20,9 L15,9" Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <TextBox Grid.Column="1"
                         x:Name="UrlTextBox"
                         Height="32"
                         PlaceholderText="วาง URL หน้าเว็บนิยาย แล้วกด Enter"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0"
                         KeyDown="OnUrlKeyDown" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ComboBox x:Name="ImportModeCombo" Width="108" Height="32" FontSize="12"
                              SelectedIndex="0" VerticalContentAlignment="Center"
                              SelectionChanged="OnImportModeChanged"
                              ToolTip.Tip="เลือกรูปแบบการดึงหลายตอน">
                        <ComboBoxItem Content="จำนวนตอน" />
                        <ComboBoxItem Content="ช่วงตอน" />
                    </ComboBox>

                    <StackPanel x:Name="CountPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBox x:Name="ChapterCountBox" Text="1" Width="48" Height="32" FontSize="12"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 ToolTip.Tip="จำนวนตอนที่ต้องการดึงต่อเนื่อง (1-200)" />
                        <TextBlock Text="ตอน" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="RangePanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="False">
                        <TextBox x:Name="RangeStartBox" Text="1" Width="44" Height="32" FontSize="12"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 ToolTip.Tip="เลขตอนเริ่มต้น" />
                        <TextBlock Text="-" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="RangeEndBox" Text="10" Width="44" Height="32" FontSize="12"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 ToolTip.Tip="เลขตอนสิ้นสุด" />
                    </StackPanel>

                    <Button x:Name="KeepOpenButton"
                            Content="ดึงเนื้อหา &amp; เปิดค้างไว้"
                            Height="32"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="ดึงเนื้อหาหน้านี้ (หรือหลายตอนตามที่ระบุ) เข้าเรื่อง แล้วเปิดหน้าต่างนี้ค้างไว้"
                            Click="OnImportKeepOpenClicked" />
                    <Button x:Name="ImportCloseButton"
                            Content="ดึงเนื้อหา &amp; ปิด"
                            Classes="primary"
                            Height="32"
                            Padding="14,0"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="ดึงเนื้อหาหน้านี้ (หรือหลายตอนตามที่ระบุ) เข้าเรื่อง แล้วปิดหน้าต่างนี้"
                            Click="OnImportAndCloseClicked" />
                    <Button x:Name="StopImportButton"
                            Content="หยุด"
                            Classes="danger"
                            Height="32"
                            Padding="12,0"
                            IsVisible="False"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="หยุดการดึงหลายตอนต่อเนื่อง"
                            Click="OnStopImportClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- พื้นที่แสดงเว็บเบราว์เซอร์ (WebView2 Incognito) -->
        <controls:WebView2Host Grid.Row="1" x:Name="WebView" />

        <!-- แถบสถานะด้านล่าง -->
        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="StatusText"
                       Text="กำลังเตรียมเบราว์เซอร์ (โหมดไม่ระบุตัวตน)..."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
