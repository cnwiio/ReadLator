<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:NovelTranslator.App.Controls"
        x:Class="NovelTranslator.App.Views.BrowserImportWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="เบราว์เซอร์ดึงเนื้อหา (โหมดไม่ระบุตัวตน)"
        Width="1120"
        Height="760"
        MinWidth="800"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBgBrush}">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- แถบเครื่องมือด้านบน -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BackButton" Content="←" Classes="ghost" Width="30" Height="30" Padding="0"
                            IsEnabled="False" ToolTip.Tip="ย้อนกลับ" Click="OnBackClicked" />
                    <Button x:Name="ForwardButton" Content="→" Classes="ghost" Width="30" Height="30" Padding="0"
                            IsEnabled="False" ToolTip.Tip="ไปข้างหน้า" Click="OnForwardClicked" />
                    <Button x:Name="ReloadButton" Content="↻" Classes="ghost" Width="30" Height="30" Padding="0"
                            ToolTip.Tip="โหลดหน้าใหม่" Click="OnReloadClicked" />
                </StackPanel>

                <TextBox Grid.Column="1"
                         x:Name="UrlTextBox"
                         Height="32"
                         PlaceholderText="วาง URL หน้าเว็บนิยาย แล้วกด Enter..."
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         KeyDown="OnUrlKeyDown" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="KeepOpenButton"
                            Content="ดึงเนื้อหา &amp; เปิดค้างไว้"
                            Height="32"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="ดึงเนื้อหาหน้านี้เข้าเรื่อง แล้วเปิดหน้าต่างนี้ค้างไว้เพื่อกดตอนถัดไป"
                            Click="OnImportKeepOpenClicked" />
                    <Button x:Name="ImportCloseButton"
                            Content="ดึงเนื้อหา &amp; ปิด"
                            Classes="primary"
                            Height="32"
                            Padding="14,0"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="ดึงเนื้อหาหน้านี้เข้าเรื่อง แล้วปิดหน้าต่างนี้"
                            Click="OnImportAndCloseClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- พื้นที่แสดงเว็บเบราว์เซอร์ (WebView2 Incognito) -->
        <controls:WebView2Host Grid.Row="1" x:Name="WebView" />

        <!-- แถบสถานะด้านล่าง -->
        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="StatusText"
                       Text="กำลังเตรียมเบราว์เซอร์ (โหมดไม่ระบุตัวตน)..."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
