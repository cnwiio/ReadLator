<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NovelTranslator.App.Views.FirstRunWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="ยินดีต้อนรับสู่ NovelTranslator"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Margin="12"
            CornerRadius="12"
            Background="{DynamicResource MainBgBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            BoxShadow="0 8 32 0 #60000000">
        <Grid RowDefinitions="Auto, *">
            <!-- Titlebar -->
            <Border Background="{DynamicResource HeaderBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0"
                    Height="40"
                    Padding="16,0,8,0"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="เริ่มต้นใช้งานครั้งแรก (First-Run Setup)"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Click="OnSkipClicked"
                            Width="28" Height="28" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.5" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="ตั้งค่าการเชื่อมต่อ AI"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="เลือกผู้ให้บริการ AI ที่คุณใช้งาน (Local เช่น Ollama / LM Studio หรือ Cloud API) แล้วกรอกรายละเอียดด้านล่าง"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="100, *" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="12">
                            <TextBlock Text="ผู้ให้บริการ" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="BackendComboBox" Grid.Column="1" SelectedIndex="0"
                                      SelectionChanged="OnBackendSelectionChanged"
                                      HorizontalAlignment="Stretch" Height="32">
                                <ComboBoxItem Content="Ollama (Local)" />
                                <ComboBoxItem Content="LM Studio (Local)" />
                                <ComboBoxItem Content="Custom / Cloud API (OpenAI-compatible)" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Base URL" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="BaseUrlBox" Grid.Row="1" Grid.Column="1" Text="http://localhost:11434/v1" Height="32" VerticalContentAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="API Key" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="ApiKeyBox" Grid.Row="2" Grid.Column="1" PasswordChar="●" PlaceholderText="เว้นว่างได้สำหรับ Ollama / LM Studio" Height="32" VerticalContentAlignment="Center" />

                            <TextBlock Grid.Row="3" Text="ชื่อโมเดล" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="ModelBox" Grid.Row="3" Grid.Column="1" PlaceholderText="เช่น qwen2.5:7b, google/gemma-4-e4b, gpt-4o-mini" Height="32" VerticalContentAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="StatusText" IsVisible="False" FontSize="12" TextWrapping="Wrap" Foreground="#E5484D" />

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="บันทึกและเริ่มใช้งาน" Classes="primary" Click="OnSaveClicked"
                                    Height="32" Padding="16,0" FontSize="13" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="สามารถเปลี่ยนการตั้งค่าทั้งหมดได้ภายหลังที่ปุ่ม ตั้งค่า"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="ข้ามไปตั้งค่าภายหลัง" Classes="ghost" Click="OnSkipClicked"
                            Height="32" Padding="12,0" FontSize="13" VerticalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
