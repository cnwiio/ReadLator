<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovelTranslator.App.ViewModels"
        xmlns:models="using:NovelTranslator.Core.Models"
        x:Class="NovelTranslator.App.Views.GlossaryWindow"
        x:DataType="vm:GlossaryViewModel"
        Title="📚 จัดการพจนานุกรมศัพท์เฉพาะ (Glossary)"
        Width="820" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBgBrush}">

    <Grid Margin="16" RowDefinitions="Auto, *, Auto, Auto">
        <!-- แถบด้านบน: ค้นหา + นำเข้า/ส่งออก -->
        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
            <TextBox Text="{Binding SearchFilter}" PlaceholderText="🔍 ค้นหาคำศัพท์ (คำต้นฉบับ / คำแปล / หมายเหตุ)..." MaxWidth="360" HorizontalAlignment="Left" Width="340" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#16A085" FontWeight="SemiBold" Margin="0,0,8,0" />
                <Button Content="📥 นำเข้า CSV" Click="OnImportCsvClicked" />
                <Button Content="📤 ส่งออก CSV" Click="OnExportCsvClicked" />
            </StackPanel>
        </Grid>

        <!-- ตารางแสดงรายการคำศัพท์ -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="คำต้นฉบับ (Source)" Binding="{Binding SourceTerm}" Width="180" />
                    <DataGridTextColumn Header="คำแปล (Target)" Binding="{Binding TargetTerm}" Width="180" />
                    <DataGridTextColumn Header="หมวดหมู่" Binding="{Binding CategoryDisplay}" Width="120" />
                    <DataGridTextColumn Header="หมายเหตุ" Binding="{Binding Notes}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ฟอร์มเพิ่ม/แก้ไขคำศัพท์ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*, *, 135, *" RowDefinitions="Auto, Auto">
                <TextBlock Text="คำต้นฉบับ:" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Grid.Column="1" Text="คำแปล:" FontWeight="SemiBold" Margin="8,0,0,4" />
                <TextBlock Grid.Column="2" Text="หมวดหมู่:" FontWeight="SemiBold" Margin="8,0,0,4" />
                <TextBlock Grid.Column="3" Text="หมายเหตุ:" FontWeight="SemiBold" Margin="8,0,0,4" />

                <TextBox Grid.Row="1" Text="{Binding SourceTerm}" PlaceholderText="เช่น Arthur, Excalibur" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetTerm}" Margin="8,0,0,0" PlaceholderText="เช่น อาเธอร์, เอ็กซ์คาลิเบอร์" />
                <ComboBox Grid.Row="1" Grid.Column="2" SelectedIndex="{Binding CategoryIndex}" Margin="8,0,0,0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="👤 ชื่อคน" />
                    <ComboBoxItem Content="📍 สถานที่" />
                    <ComboBoxItem Content="📘 ศัพท์ทั่วไป" />
                </ComboBox>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Notes}" Margin="8,0,0,0" PlaceholderText="คำอธิบายเพิ่มเติม" />
            </Grid>
        </Border>

        <!-- ปุ่มควบคุมด้านล่าง -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button Content="🧹 ล้างฟอร์ม" Command="{Binding ClearInputsCommand}" />
            <Button Content="🗑️ ลบคำนี้" Command="{Binding DeleteEntryCommand}" Background="#E74C3C" Foreground="White" />
            <Button Content="💾 บันทึกคำศัพท์" Classes="accent" Command="{Binding SaveEntryCommand}" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
