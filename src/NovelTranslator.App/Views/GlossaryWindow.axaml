<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovelTranslator.App.ViewModels"
        xmlns:models="using:NovelTranslator.Core.Models"
        x:Class="NovelTranslator.App.Views.GlossaryWindow"
        x:DataType="vm:GlossaryViewModel"
        Title="พจนานุกรมศัพท์เฉพาะ (Glossary)"
        Width="820" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBgBrush}">

    <Grid Margin="20" RowDefinitions="Auto, *, Auto, Auto">
        <!-- แถบด้านบน: ค้นหา + นำเข้า/ส่งออก -->
        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
            <TextBox Text="{Binding SearchFilter}" Height="32" VerticalContentAlignment="Center"
                     PlaceholderText="ค้นหาคำศัพท์" Width="320" HorizontalAlignment="Left" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                <Button Content="นำเข้า CSV" Click="OnImportCsvClicked" Height="32" FontSize="13" />
                <Button Content="ส่งออก CSV" Click="OnExportCsvClicked" Height="32" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- ตารางแสดงรายการคำศัพท์ -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="คำต้นฉบับ" Binding="{Binding SourceTerm}" Width="180" />
                    <DataGridTextColumn Header="คำแปล" Binding="{Binding TargetTerm}" Width="180" />
                    <DataGridTextColumn Header="หมวดหมู่" Binding="{Binding CategoryDisplay}" Width="120" />
                    <DataGridTextColumn Header="หมายเหตุ" Binding="{Binding Notes}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ฟอร์มเพิ่ม/แก้ไขคำศัพท์ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="16" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*, *, 136, *" RowDefinitions="Auto, Auto">
                <TextBlock Text="คำต้นฉบับ" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock Grid.Column="1" Text="คำแปล" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,4" />
                <TextBlock Grid.Column="2" Text="หมวดหมู่" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,4" />
                <TextBlock Grid.Column="3" Text="หมายเหตุ" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,4" />

                <TextBox Grid.Row="1" Text="{Binding SourceTerm}" Height="32" VerticalContentAlignment="Center" PlaceholderText="เช่น Arthur, Excalibur" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetTerm}" Height="32" VerticalContentAlignment="Center" Margin="8,0,0,0" PlaceholderText="เช่น อาเธอร์, เอ็กซ์คาลิเบอร์" />
                <ComboBox Grid.Row="1" Grid.Column="2" SelectedIndex="{Binding CategoryIndex}" Height="32" Margin="8,0,0,0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="ชื่อคน" />
                    <ComboBoxItem Content="สถานที่" />
                    <ComboBoxItem Content="ศัพท์ทั่วไป" />
                </ComboBox>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Notes}" Height="32" VerticalContentAlignment="Center" Margin="8,0,0,0" PlaceholderText="คำอธิบายเพิ่มเติม" />
            </Grid>
        </Border>

        <!-- ปุ่มควบคุมด้านล่าง -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="ล้างฟอร์ม" Command="{Binding ClearInputsCommand}" Height="32" FontSize="13" />
            <Button Content="ลบคำนี้" Classes="danger" Command="{Binding DeleteEntryCommand}" Height="32" FontSize="13" />
            <Button Content="บันทึกคำศัพท์" Classes="primary" Command="{Binding SaveEntryCommand}" Height="32" FontSize="13" />
        </StackPanel>
    </Grid>
</Window>
