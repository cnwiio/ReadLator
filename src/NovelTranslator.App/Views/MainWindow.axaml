<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovelTranslator.App.ViewModels"
        x:Class="NovelTranslator.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="โปรแกรมแปลนิยายด้วย AI (NovelTranslator) v7.4"
        Width="1400" Height="880"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MainBgBrush}">

    <Grid>
        <!-- มุมมองการทำงานปกติ (Editing Workspace) -->
        <Grid RowDefinitions="Auto, *" IsVisible="{Binding !IsFocusMode}">
            <!-- Application Header (Quiet Cool Graphite Chrome, 4px grid) -->
            <Border Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1" Padding="16,8">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- โลโก้หนังสือ + ชื่อแอป -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Path Data="M2,4 C2,2.9 2.9,2 4,2 L10,2 C11.1,2 12,2.9 12,4 L12,18 C12,16.9 11.1,16 10,16 L4,16 C2.9,16 2,15.1 2,14 Z M22,4 C22,2.9 21.1,2 20,2 L14,2 C12.9,2 12,2.9 12,4 L12,18 C12,16.9 12.9,16 14,16 L20,16 C21.1,16 22,15.1 22,14 Z"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="NovelTranslator" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- ปุ่มพับ/เปิดแถบซ้าย -->
                    <Button Command="{Binding ToggleSidebarCommand}" Padding="8,6" Height="32"
                            VerticalAlignment="Center" ToolTip.Tip="{Binding SidebarToggleText}">
                        <Border Width="16" Height="13" CornerRadius="2" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.5">
                            <Grid ColumnDefinitions="5, *">
                                <Border Grid.Column="0" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="0,0,1.5,0">
                                    <Border Background="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsSidebarVisible}" Margin="1" CornerRadius="0.5" />
                                </Border>
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- ป้ายสถานะโมเดล AI ปัจจุบัน -->
                    <Button Command="{Binding OpenSettingsCommand}" Classes="ghost" Height="32" Padding="10,4"
                            ToolTip.Tip="คลิกเพื่อตั้งค่า AI หรือเปลี่ยนโมเดล">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#4CC38A" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveModelDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- ปุ่มเมนูเครื่องมือ (3 ขีด ☰) -->
                    <Button Width="32" Height="32" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="เมนูเครื่องมือและไฟล์">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75" StrokeLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="บันทึกตอนนี้" Command="{Binding SaveCurrentChapterCommand}" InputGesture="{Binding Settings.Shortkeys.SaveKey}" />
                                <Separator />
                                <MenuItem Header="{Binding SearchReplaceMenuText}" Command="{Binding OpenSearchReplaceCommand}" />
                                <MenuItem Header="พจนานุกรมคำศัพท์ (Glossary)" Command="{Binding OpenGlossaryCommand}" />
                                <MenuItem Header="สแกนหาศัพท์ใหม่ในตอนนี้ (AI)" Command="{Binding ScanNewTermsCommand}" />
                                <Separator />
                                <MenuItem Header="นำเข้าไฟล์นิยาย (.txt)" Command="{Binding ImportTxtFilesCommand}" />
                                <MenuItem Header="นำเข้าจาก URL (Reader Mode)..." Command="{Binding ImportFromUrlCommand}" />
                                <MenuItem Header="เปิดเบราว์เซอร์ดึงเนื้อหา (WebView)..." Command="{Binding OpenBrowserImportCommand}" />
                                <MenuItem Header="ส่งออกตอนนี้ (.txt)" Command="{Binding ExportCurrentChapterCommand}" />
                                <MenuItem Header="ส่งออกทั้งเรื่อง (.txt)" Command="{Binding ExportStoryCommand}" />
                                <MenuItem Header="ส่งออกเป็นเว็บอ่านบนมือถือ (.html)..." Command="{Binding ExportMobileHtmlCommand}" />
                                <MenuItem Header="ส่งออกเป็นอีบุ๊ก (.epub)..." Command="{Binding ExportEpubCommand}" />
                                <MenuItem Header="{Binding WifiServerMenuText}" Command="{Binding ToggleWifiServerCommand}" />
                                <Separator />
                                <MenuItem Header="สำรองฐานข้อมูล (.db)" Command="{Binding BackupDatabaseCommand}" />
                                <MenuItem Header="กู้คืนฐานข้อมูล (.db)" Command="{Binding RestoreDatabaseCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- ปุ่มสลับโหมดสี (เปลี่ยนไอคอนตามโหมดปัจจุบัน) -->
                    <Button Command="{Binding CycleThemeCommand}" Width="32" Height="32" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="{Binding ThemeButtonTooltip}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <!-- โหมดสว่าง: พระอาทิตย์ (Sun) -->
                                <Canvas Width="24" Height="24" IsVisible="{Binding IsLightTheme}">
                                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8"
                                             Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75" />
                                    <Path Data="M12,2 L12,4 M12,20 L12,22 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M2,12 L4,12 M20,12 L22,12 M4.93,19.07 L6.34,17.66 M17.66,6.34 L19.07,4.93"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75" StrokeLineCap="Round" />
                                </Canvas>
                                <!-- โหมดมืด: พระจันทร์เสี้ยว (Moon) -->
                                <Path Data="M21,12.79 A9,9 0 1,1 11.21,3 A7,7 0 0,0 21,12.79 Z"
                                      IsVisible="{Binding IsDarkTheme}"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                <!-- โหมดถนอมสายตา: ดวงตา (Eye-care / Sepia) -->
                                <Canvas Width="24" Height="24" IsVisible="{Binding IsSepiaTheme}">
                                    <Path Data="M2,12 C4.5,7 8,4.5 12,4.5 C16,4.5 19.5,7 22,12 C19.5,17 16,19.5 12,19.5 C8,19.5 4.5,17 2,12 Z"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75"
                                          StrokeLineCap="Round" StrokeJoin="Round" />
                                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                             Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75" />
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- ปุ่มตั้งค่ารวมรูปฟันเฟือง ⚙ -->
                    <Button Command="{Binding OpenSettingsCommand}" Width="32" Height="32" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="การตั้งค่าทั้งหมด (AI, ปุ่มลัด, ระบบ)">
                        <Path Data="M12,15.5 A3.5,3.5 0 1,0 12,8.5 A3.5,3.5 0 0,0 12,15.5 Z M19.4,13 A7.8,7.8 0 0,0 19.5,12 A7.8,7.8 0 0,0 19.4,11 L21.5,9.4 A0.5,0.5 0 0,0 21.6,8.7 L19.6,5.3 A0.5,0.5 0 0,0 19,5.1 L16.5,6.1 A7.9,7.9 0 0,0 14.8,5.1 L14.4,2.5 A0.5,0.5 0 0,0 13.9,2 L9.9,2 A0.5,0.5 0 0,0 9.4,2.5 L9.1,5.1 A7.9,7.9 0 0,0 7.3,6.1 L4.8,5.1 A0.5,0.5 0 0,0 4.2,5.3 L2.2,8.7 A0.5,0.5 0 0,0 2.3,9.4 L4.4,11 A7.8,7.8 0 0,0 4.3,12 A7.8,7.8 0 0,0 4.4,13 L2.3,14.6 A0.5,0.5 0 0,0 2.2,15.3 L4.2,18.7 A0.5,0.5 0 0,0 4.8,18.9 L7.3,17.9 A7.9,7.9 0 0,0 9.1,18.9 L9.4,21.5 A0.5,0.5 0 0,0 9.9,22 L13.9,22 A0.5,0.5 0 0,0 14.4,21.5 L14.8,18.9 A7.9,7.9 0 0,0 16.5,17.9 L19,18.9 A0.5,0.5 0 0,0 19.6,18.7 L21.6,15.3 A0.5,0.5 0 0,0 21.5,14.6 Z"
                              Fill="{DynamicResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- พื้นที่ทำงานหลัก: แถบซ้าย 280px + พื้นที่แปลด้านขวา -->
        <Grid x:Name="MainLayoutGrid" Grid.Row="1" ColumnDefinitions="280, 4, *">
            <!-- แถบซ้าย: รายการเรื่องและตอน -->
            <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0" Padding="16" IsVisible="{Binding IsSidebarVisible}">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *, Auto">
                    <!-- หมวดนิยาย -->
                    <TextBlock Text="นิยาย" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,12">
                        <ComboBox ItemsSource="{Binding Stories}" SelectedItem="{Binding SelectedStory}" Height="32" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Command="{Binding ToggleStoryDetailsCommand}" Width="32" Height="32" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="แก้ไขชื่อเรื่องและคำแนะนำสำนวน (Style Notes)" Margin="4,0,0,0">
                            <Path Data="M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 L3,17.25 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 Z"
                                  Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                        <Button Grid.Column="2" Command="{Binding CreateStoryCommand}" Width="32" Height="32" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="สร้างเรื่องใหม่" Margin="4,0,0,0">
                            <Path Data="M19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 L11,5 L13,5 L13,11 L19,11 L19,13 Z"
                                  Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- แผงแก้ไขชื่อเรื่องและ Style Notes -->
                    <Border Grid.Row="2" IsVisible="{Binding IsStoryDetailsExpanded}"
                            Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ชื่อเรื่อง" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding StoryTitleEdit}" PlaceholderText="ชื่อเรื่องนิยาย" />
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="คำแนะนำสำนวน (Style Notes)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <!-- ปุ่มเลือก Preset สไตล์สำเร็จรูป -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="ปัจจุบัน" Command="{Binding ApplyStylePresetCommand}" CommandParameter="Modern"
                                        Padding="6,2" FontSize="11" Height="24" ToolTip.Tip="ใช้ ผม/ฉัน บทสนทนาธรรมชาติ" />
                                <Button Content="จีนโบราณ" Command="{Binding ApplyStylePresetCommand}" CommandParameter="Wuxia"
                                        Padding="6,2" FontSize="11" Height="24" ToolTip.Tip="ใช้ ข้า/เจ้า/ท่าน สำนวนยุทธภพ" />
                                <Button Content="แฟนตาซี" Command="{Binding ApplyStylePresetCommand}" CommandParameter="Fantasy"
                                        Padding="6,2" FontSize="11" Height="24" ToolTip.Tip="สากล สรรพนามตามฐานะตัวละคร" />
                                <Button Content="ดาร์ก/ขรึม" Command="{Binding ApplyStylePresetCommand}" CommandParameter="Dark"
                                        Padding="6,2" FontSize="11" Height="24" ToolTip.Tip="น้ำเสียงขรึม กระชับ ไม่ฟุ่มเฟือย" />
                            </StackPanel>
                            <TextBox Text="{Binding StoryStyleNotesEdit}" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                                     PlaceholderText="เช่น นิยายจีนกำลังภายใน ใช้ ข้า/เจ้า หรือกดปุ่มด้านบน" />
                            <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                <Button Content="บันทึก" Classes="primary" Command="{Binding SaveStoryDetailsCommand}" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="ลบเรื่อง" Classes="danger" Command="{Binding DeleteStoryCommand}" Height="32"
                                        Margin="8,0,0,0" ToolTip.Tip="ลบนิยายเรื่องนี้และทุกตอน" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ความคืบหน้าของทั้งเรื่อง -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="ความคืบหน้า" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding StoryProgressText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding StoryProgressPercentage}" Height="4" Foreground="#2563EB" />
                        </StackPanel>
                    </Border>

                    <!-- หัวข้อรายการตอน -->
                    <Grid Grid.Row="4" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,8">
                        <TextBlock Text="รายการตอน" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="เพิ่มตอน" Command="{Binding CreateChapterCommand}" ToolTip.Tip="เพิ่มตอนใหม่" Height="28" Padding="8,0" FontSize="12" Margin="2,0,0,0" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="ตัวเลือกการเพิ่มตอน">
                            <Path Data="M12,6 C13.1,6 14,5.1 14,4 C14,2.9 13.1,2 12,2 C10.9,2 10,2.9 10,4 C10,5.1 10.9,6 12,6 Z M12,14 C13.1,14 14,13.1 14,12 C14,10.9 13.1,10 12,10 C10.9,10 10,10.9 10,12 C10,13.1 10.9,14 12,14 Z M12,22 C13.1,22 14,21.1 14,20 C14,18.9 13.1,18 12,18 C10.9,18 10,18.9 10,20 C10,21.1 10.9,22 12,22 Z"
                                  Fill="{DynamicResource TextSecondaryBrush}" Width="4" Height="14" Stretch="Uniform" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="แทรกตอนก่อนหน้าตอนที่เลือก" Command="{Binding InsertChapterBeforeCommand}" />
                                    <MenuItem Header="แทรกตอนต่อจากตอนที่เลือก" Command="{Binding InsertChapterAfterCommand}" />
                                    <Separator />
                                    <MenuItem Header="เพิ่มหลายตอนพร้อมกัน..." Command="{Binding AddMultipleChaptersCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- ช่องค้นหาและกรองสถานะตอน -->
                    <Grid Grid.Row="5" ColumnDefinitions="*, 104" Margin="0,0,0,8">
                        <TextBox Text="{Binding ChapterSearchFilter}" PlaceholderText="ค้นหาตอน" Height="32" VerticalContentAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding ChapterStatusFilterIndex}" Height="32" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                                  FontSize="12" ToolTip.Tip="กรองรายการตอนตามสถานะ">
                            <ComboBoxItem Content="ทั้งหมด" />
                            <ComboBoxItem Content="ยังไม่แปล" />
                            <ComboBoxItem Content="แปลแล้ว" />
                            <ComboBoxItem Content="แก้ไขแล้ว" />
                        </ComboBox>
                    </Grid>

                    <!-- รายการตอน (Drag Handle ☰ + Multi-select) -->
                    <Border Grid.Row="6" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4">
                        <ListBox x:Name="ChapterListBox"
                                 ItemsSource="{Binding FilteredChapters}"
                                 SelectionMode="Multiple"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto, *, Auto" Height="28" Background="Transparent">
                                        <!-- ไอคอน 3 ขีดแนวนอน (Drag Handle ☰) -->
                                        <Border Background="Transparent" Width="20" Height="24" Margin="0,0,6,0"
                                                Cursor="Hand" ToolTip.Tip="คลิกลากเพื่อย้ายลำดับตอน"
                                                PointerPressed="OnDragHandlePointerPressed">
                                            <Path Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15"
                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round"
                                                  Width="14" Height="12" Stretch="Uniform"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <!-- ชื่อตอนปกติ (ดับเบิ้ลคลิก หรือกด F2 หรือคลิกขวาเพื่อเปลี่ยนชื่อ) -->
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsEditingTitle}"
                                                   DoubleTapped="OnChapterTitleDoubleTapped">
                                            <TextBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="เปลี่ยนชื่อตอน (F2)" Click="OnRenameChapterMenuItemClicked" />
                                                </ContextMenu>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>

                                        <!-- ช่องแก้ไขชื่อตอนแบบ Inline ในแถว (เรียบเนียน ไม่ลอยปูด เสมอกับแถวปกติ) -->
                                        <TextBox Grid.Column="1" Text="{Binding EditingTitle, Mode=TwoWay}"
                                                 FontSize="13" Height="24" MinHeight="22" Padding="4,0" Margin="0"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 CornerRadius="4" BorderThickness="1"
                                                 Background="Transparent" BorderBrush="{DynamicResource AccentBrush}"
                                                 IsVisible="{Binding IsEditingTitle}"
                                                 KeyDown="OnChapterRenameTextBoxKeyDown"
                                                 LostFocus="OnChapterRenameTextBoxLostFocus"
                                                 PropertyChanged="OnChapterRenameTextBoxPropertyChanged" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBadgeColor}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- ปุ่มเลือกทั้งหมด & ลบตอนด้านล่าง (Quiet Danger style) + เลิกทำ -->
                    <StackPanel Grid.Row="7" Spacing="6" Margin="0,12,0,0">
                        <Button Content="{Binding UndoDeleteButtonText}" Command="{Binding UndoDeleteChapterCommand}"
                                IsVisible="{Binding CanUndoDeleteChapter}"
                                Height="32" FontSize="12" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="กู้คืนตอนที่เพิ่งลบ (Ctrl+Z)" />
                        <Grid ColumnDefinitions="Auto, *">
                            <Button Content="เลือกทั้งหมด" Command="{Binding ToggleSelectAllChaptersCommand}"
                                    Height="32" FontSize="12" Padding="10,0" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="ลบตอนที่เลือก" Classes="danger" Command="{Binding DeleteChapterCommand}"
                                    Height="32" FontSize="12" Margin="8,0,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ตัวลากปรับขนาดแถบซ้าย -->
            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" IsVisible="{Binding IsSidebarVisible}" />

            <!-- พื้นที่หลักด้านขวา -->
            <Grid Grid.Column="2" RowDefinitions="Auto, *, Auto" Margin="16,12,16,12">
                <!-- แถบควบคุมหลักเหนือช่องแปล (สะอาดตา มีปุ่ม Primary สีน้ำเงินเพียงจุดเดียว) -->
                <Border Background="{DynamicResource CardBgBrush}" Padding="12,8" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                            <!-- ปุ่มตอนก่อนหน้า / ถัดไป -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Command="{Binding PreviousChapterCommand}" Width="32" Height="32" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{Binding PrevChapterTooltipText}">
                                    <Path Data="M15,18 L9,12 L15,6" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" />
                                </Button>
                                <Button Command="{Binding NextChapterCommand}" Width="32" Height="32" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{Binding NextChapterTooltipText}">
                                    <Path Data="M9,18 L15,12 L9,6" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" />
                                </Button>
                            </StackPanel>

                            <!-- ชื่อตอน + จุดสถานะ (Inline สะอาดตา ไม่เป็นกล่อง) -->
                            <Grid Grid.Column="1" ColumnDefinitions="*, Auto" Margin="8,0,12,0" VerticalAlignment="Center">
                                <TextBox Text="{Binding ChapterTitleEdit}" PlaceholderText="ตั้งชื่อตอน"
                                         FontWeight="Medium" FontSize="14" Height="32" VerticalContentAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,4,0">
                                    <Ellipse Width="6" Height="6" Fill="{Binding ChapterStatusColor}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ChapterStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- ปุ่มควบคุมการแปล (Primary แปลตอนนี้ + เมนูย่อย ▾) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="primary" Command="{Binding StartTranslationCommand}"
                                        IsEnabled="{Binding !IsTranslating}" Height="32" Padding="12,0"
                                        ToolTip.Tip="{Binding TranslateTooltipText}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="แปลตอนนี้" FontWeight="Medium" Padding="0,2,0,0" Margin="0,-1,0,0" VerticalAlignment="Center" />
                                        <Border Background="#1D4ED8" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TranslateKeyText}" FontSize="11" Foreground="#DBEAFE" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <!-- ปุ่มตัวเลือกการแปลเพิ่มเติม ▾ -->
                                <Button Width="32" Height="32" Padding="0"
                                        IsEnabled="{Binding !IsTranslating}"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="ตัวเลือกการแปลเพิ่มเติม">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,9 L12,15 L18,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="แปลทุกตอนที่เหลือ" Command="{Binding TranslateAllChaptersCommand}"
                                                      ToolTip.Tip="{Binding TranslateAllTooltipText}">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18"
                                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75" StrokeLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="แปลใหม่ (ล้างคำแปลเดิม)" Command="{Binding RetranslateAllCommand}"
                                                      ToolTip.Tip="ล้างคำแปลเดิมของตอนนี้แล้วแปลใหม่ตั้งแต่ต้น">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M20,12 A8,8 0 1,1 18.93,8 M19,3.5 L18.93,8 L14.4,8"
                                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75"
                                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- แถบความคืบหน้าการแปลและแจ้งข้อผิดพลาด (แสดงเฉพาะเมื่อมีข้อความสถานะหรือกำลังแปล) -->
                        <StackPanel Spacing="6" IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasError}">
                                    <Button Content="คัดลอกข้อผิดพลาด" Command="{Binding CopyErrorDetailsCommand}" Height="24" FontSize="11" Padding="8,0" />
                                    <Button Content="ดูรายละเอียด" Command="{Binding ShowErrorDialogCommand}" Height="24" FontSize="11" Padding="8,0" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsTranslating}">
                                <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding TranslationProgressPercentage}"
                                             IsIndeterminate="{Binding IsTranslatingIndeterminate}"
                                             Height="4" Foreground="#2563EB" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="danger" Content="หยุด" Command="{Binding StopTranslationCommand}"
                                        Height="24" FontSize="11" Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="หยุดการแปลชั่วคราว/ยกเลิก" />
                            </Grid>
                        </StackPanel>

                        <!-- แถบแจ้งเตือนชื่อเฉพาะที่ถูกเพิ่มเข้า Glossary อัตโนมัติ -->
                        <Border IsVisible="{Binding HasAutoGlossaryNotification}"
                                Background="{DynamicResource RaisedBgBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <TextBlock Text="{Binding AutoGlossaryNotificationText}"
                                           FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding AutoGlossaryNotificationText}" />
                                <Button Grid.Column="1" Content="ดู/แก้ไขใน Glossary"
                                        Command="{Binding OpenGlossaryFromNotificationCommand}"
                                        Height="24" FontSize="11" Padding="10,0" Margin="8,0,4,0"
                                        VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Content="✕" Classes="ghost"
                                        Command="{Binding DismissAutoGlossaryNotificationCommand}"
                                        Width="24" Height="24" Padding="0" FontSize="11"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="ปิดการแจ้งเตือน" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- พื้นที่แก้ไขข้อความหลัก (Sub-row 0: แถบเครื่องมือมุมมอง, Sub-row 1: หัวคอลัมน์, Sub-row 2: กระดาษคู่ขนาน) -->
                <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *">
                    <!-- แถบเครื่องมือมุมมอง (ซ้าย: โหมดมุมมองและแผงแยก [◧][◨], ขวา: โหมดอ่านและฟอนต์) -->
                    <Grid Height="32" Margin="0,0,0,8">
                        <!-- ฝั่งซ้าย: กลุ่มควบคุมมุมมองและแผงหน้าต่าง -->
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <!-- ปุ่มสลับโหมดมุมมอง: ข้อความปกติ ↔ จับคู่รายย่อหน้า -->
                            <Button Content="{Binding Editor.ParagraphModeButtonText}" Command="{Binding ToggleParagraphModeCommand}"
                                    Height="28" FontSize="12" Padding="10,0" VerticalContentAlignment="Center"
                                    ToolTip.Tip="สลับระหว่างมุมมองปกติ กับโหมดจับคู่รายย่อหน้า" />

                            <!-- ปุ่มไอคอนสากล เปิด/ปิด แผงต้นฉบับ (ซ้าย) และ แผงคำแปล (ขวา) สไตล์ VS Code -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Command="{Binding ToggleOriginalPaneCommand}" Width="24" Height="22" Padding="0"
                                            Classes="ghost"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Opacity="{Binding OriginalPaneToggleOpacity}"
                                            ToolTip.Tip="แสดง/ซ่อนแผงต้นฉบับ (ซ้าย)">
                                        <Viewbox Width="14" Height="14">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4,5 L11,5 L11,19 L4,19 Z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      IsVisible="{Binding IsOriginalPaneVisible}" Opacity="0.35" />
                                                <Path Data="M3,5 C3,3.9 3.9,3 5,3 L19,3 C20.1,3 21,3.9 21,5 L21,19 C21,20.1 20.1,21 19,21 L5,21 C3.9,21 3,20.1 3,19 Z M12,3 L12,21"
                                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.75" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>

                                    <Button Command="{Binding ToggleTranslatedPaneCommand}" Width="24" Height="22" Padding="0"
                                            Classes="ghost"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Opacity="{Binding TranslatedPaneToggleOpacity}"
                                            ToolTip.Tip="แสดง/ซ่อนแผงคำแปล (ขวา)">
                                        <Viewbox Width="14" Height="14">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M13,5 L20,5 L20,19 L13,19 Z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      IsVisible="{Binding IsTranslatedPaneVisible}" Opacity="0.35" />
                                                <Path Data="M3,5 C3,3.9 3.9,3 5,3 L19,3 C20.1,3 21,3.9 21,5 L21,19 C21,20.1 20.1,21 19,21 L5,21 C3.9,21 3,20.1 3,19 Z M12,3 L12,21"
                                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.75" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ฝั่งขวา: ปุ่มเข้าสู่โหมดอ่าน และ ตัวเลือกฟอนต์/มุมมอง -->
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding ToggleFocusModeCommand}" Height="28" FontSize="12" Padding="8,0"
                                    VerticalContentAlignment="Center"
                                    ToolTip.Tip="{Binding FocusModeTooltipText}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FocusModeButtonText}" VerticalAlignment="Center" />
                                    <Border Classes="keycap" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FocusModeKeyText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button Height="28" FontSize="12" Padding="10,0" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="ตัวอักษรและมุมมอง" VerticalAlignment="Center" />
                                    <Path Data="M6,9 L12,15 L18,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="12" Width="240" Margin="4">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="ฟอนต์เนื้อหา" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <ComboBox ItemsSource="{Binding AvailableEditorFonts}" SelectedItem="{Binding EditorFontFamily, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch" FontSize="12" />
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                                <TextBlock Text="ขนาดตัวอักษร" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="A-" Command="{Binding DecreaseFontSizeCommand}" Width="32" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding EditorFontSize, StringFormat='{}{0}px'}" FontSize="12" Width="40" TextAlignment="Center" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Content="A+" Command="{Binding IncreaseFontSizeCommand}" Width="32" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                            </Grid>
                                            <CheckBox Content="เลื่อนหน้าจอซ้าย-ขวาพร้อมกัน" IsChecked="{Binding IsSyncScrollEnabled}" FontSize="12" />
                                            <Separator Background="{DynamicResource BorderSubtleBrush}" />
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="โหมดสี (Theme)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <ComboBox SelectedIndex="{Binding ThemeModeIndex}" HorizontalAlignment="Stretch" FontSize="12" Height="30">
                                                    <ComboBoxItem Content="โหมดสว่าง (Light)" />
                                                    <ComboBoxItem Content="โหมดมืด (Dark)" />
                                                    <ComboBoxItem Content="ถนอมสายตา (Sepia)" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Text="ความสว่างหน้าจอ" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding BrightnessDisplayText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                        Value="{Binding BrightnessLevel}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- แถบหัวคอลัมน์ซ้าย-ขวา (ตรงกับแผงกระดาษแต่ละฝั่งอย่างแม่นยำ) -->
                    <Grid Grid.Row="1" Height="20" Margin="4,0,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding OriginalColumnWidth}" />
                            <ColumnDefinition Width="{Binding SplitterColumnWidth}" />
                            <ColumnDefinition Width="{Binding TranslatedColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{Binding IsOriginalPaneVisible}">
                            <TextBlock Text="ต้นฉบับ" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Button Content="นำเข้าจาก URL" Command="{Binding ImportFromUrlCommand}"
                                    Classes="ghost" Height="22" Padding="8,0" FontSize="11"
                                    VerticalContentAlignment="Center"
                                    ToolTip.Tip="ดึงเนื้อหาจากลิงก์หน้าเว็บ (Reader Mode)" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="คำแปล" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding IsTranslatedPaneVisible}" />
                    </Grid>

                    <!-- โหมดปกติ: TextBox กระดาษคู่ขนาน 2 แผ่น -->
                    <Grid x:Name="EditorSplitGrid" Grid.Row="2" ColumnDefinitions="*, 12, *"
                          IsVisible="{Binding !Editor.IsParagraphMode}">
                        <TextBox x:Name="OriginalTextBox" Grid.Column="0" Text="{Binding OriginalText, Mode=TwoWay}"
                                 IsVisible="{Binding IsOriginalPaneVisible}"
                                 FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}" LineHeight="32" Padding="20"
                                 Background="{DynamicResource EditorBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 CornerRadius="8" AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"
                                      IsVisible="{Binding IsBothPanesVisible}" />

                        <TextBox x:Name="TranslatedTextBox" Grid.Column="2" Text="{Binding TranslatedText, Mode=TwoWay}"
                                 IsVisible="{Binding IsTranslatedPaneVisible}"
                                 FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}" LineHeight="32" Padding="20"
                                 Background="{DynamicResource EditorBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 CornerRadius="8" AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Grid>

                    <!-- โหมดจับคู่รายย่อหน้าแบบ Minimal: กระดาษ 2 แผ่นโล่งๆ ไม่มีกล่องซ้อน มีเลขย่อหน้าเล็กข้างหน้า และบรรทัดตรงกัน -->
                    <Grid Grid.Row="2" IsVisible="{Binding Editor.IsParagraphMode}">
                        <!-- ชั้นพื้นหลังกระดาษซ้าย-ขวา -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding OriginalColumnWidth}" />
                                <ColumnDefinition Width="{Binding SplitterColumnWidth}" />
                                <ColumnDefinition Width="{Binding TranslatedColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" IsVisible="{Binding IsOriginalPaneVisible}"
                                    Background="{DynamicResource EditorBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="8" />
                            <Border Grid.Column="2" IsVisible="{Binding IsTranslatedPaneVisible}"
                                    Background="{DynamicResource EditorBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="8" />
                        </Grid>

                        <!-- ชั้นเนื้อหาย่อหน้าที่จับคู่ระดับบรรทัดเดียวกัน -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,20">
                            <ItemsControl ItemsSource="{Binding Editor.ParagraphPairs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding $parent[Window].((vm:MainViewModel)DataContext).OriginalColumnWidth}" />
                                                <ColumnDefinition Width="{Binding $parent[Window].((vm:MainViewModel)DataContext).SplitterColumnWidth}" />
                                                <ColumnDefinition Width="{Binding $parent[Window].((vm:MainViewModel)DataContext).TranslatedColumnWidth}" />
                                            </Grid.ColumnDefinitions>

                                            <!-- ย่อหน้าต้นฉบับด้านซ้าย -->
                                            <Grid Grid.Column="0" ColumnDefinitions="24, *" Margin="20,0"
                                                  IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsOriginalPaneVisible}">
                                                <TextBlock Text="{Binding Index}" FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Top" Margin="0,6,6,0" />
                                                <TextBox Grid.Column="1" Classes="seamless"
                                                         Text="{Binding SourceText, Mode=TwoWay}"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         FontFamily="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditorFontFamily}"
                                                         FontSize="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditorFontSize}"
                                                         LineHeight="32" />
                                            </Grid>

                                            <!-- ย่อหน้าคำแปลด้านขวา (คลิกขวาเพื่อแปลย่อหน้านี้ใหม่) -->
                                            <Grid Grid.Column="2" ColumnDefinitions="24, *" Margin="20,0"
                                                  IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsTranslatedPaneVisible}">
                                                <TextBlock Text="{Binding Index}" FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Top" Margin="0,6,6,0" />
                                                <TextBox Grid.Column="1" Classes="seamless"
                                                         Text="{Binding TranslatedText, Mode=TwoWay}"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         FontFamily="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditorFontFamily}"
                                                         FontSize="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditorFontSize}"
                                                         LineHeight="32">
                                                    <TextBox.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="แปลย่อหน้านี้ใหม่" Command="{Binding RetranslateCommand}">
                                                                <MenuItem.Icon>
                                                                    <Viewbox Width="16" Height="16">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Data="M20,12 A8,8 0 1,1 18.93,8 M19,3.5 L18.93,8 L14.4,8"
                                                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75"
                                                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </TextBox.ContextMenu>
                                                </TextBox>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- แถบสถานะด้านล่าง (Quiet Metadata + 6px Save Status Dot) -->
                <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,6" Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OriginalWordCount, StringFormat='ต้นฉบับ {0:N0} คำ'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding OriginalParagraphCount, StringFormat='{}{0:N0} ย่อหน้า'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding TranslatedWordCount, StringFormat='คำแปล {0:N0} คำ'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding StoryProgressText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding SaveStateColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SaveStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Command="{Binding SaveCurrentChapterCommand}"
                                    Classes="ghost" Width="28" Height="28" Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    ToolTip.Tip="{Binding SaveTooltipText}">
                                <Path Data="M17,3 H5 C3.89,3 3,3.9 3,5 V19 C3,20.1 3.89,21 5,21 H19 C20.1,21 21,20.1 21,19 V7 L17,3 Z M12,19 C10.34,19 9,17.66 9,16 C9,14.34 10.34,13 12,13 C13.66,13 15,14.34 15,16 C15,17.66 13.66,19 12,19 Z M6,8 V5 H15 V8 H6 Z"
                                      Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>

        <!-- โหมดอ่านหนังสือ (Reading Mode / Focus Mode) -->
        <Grid IsVisible="{Binding IsFocusMode}" Background="{DynamicResource MainBgBrush}">
            <!-- พื้นที่อ่านหนังสือ จัดกึ่งกลาง สไตล์ E-Reader ไร้กรอบกล่อง -->
            <ScrollViewer x:Name="ReadingScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" Margin="24,64,24,96" HorizontalAlignment="Center">
                    <!-- ส่วนหัวบทความสไตล์วรรณกรรม (Literary Chapter Opener) -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,40">
                        <!-- ชื่อเรื่องนิยาย (บริบทเบาๆ ด้านบน) -->
                        <TextBlock Text="{Binding SelectedStory.Title}"
                                   FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="600" />

                        <!-- หัวข้อชื่อตอนชัดเจน (FontWeight SemiBold สไตล์ Editorial) -->
                        <TextBlock Text="{Binding ChapterTitleEdit}"
                                   FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />

                        <!-- ลำดับตอน -->
                        <TextBlock Text="{Binding ReadingChapterPositionText}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextAlignment="Center" Margin="0,4,0,0" />

                        <!-- เส้นคั่นประดับเบาๆ สไตล์หนังสือ (Hairline divider / ornament) -->
                        <Border Height="1" Width="48" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- เนื้อหาคำแปล (Read-Only 100%, ไม่มีกรอบกล่อง, สบายตา) -->
                    <SelectableTextBlock x:Name="ReadingContentTextBlock"
                                         FocusAdorner="{x:Null}"
                                         IsVisible="{Binding HasTranslatedContent}"
                                         Text="{Binding TranslatedText}"
                                         FontFamily="{Binding EditorFontFamily}"
                                         FontSize="{Binding EditorFontSize}"
                                         LineHeight="{Binding ReadingLineHeight}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,0,56" />

                    <!-- กรณีตอนนี้ยังไม่มีคำแปล (Empty State ละมุนตา) -->
                    <Border IsVisible="{Binding !HasTranslatedContent}"
                            Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="32,48" Margin="0,0,0,56" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <Viewbox Width="32" Height="32" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20,12 A8,8 0 1,1 18.93,8 M19,3.5 L18.93,8 L14.4,8"
                                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                          StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="ยังไม่มีคำแปลสำหรับตอนนี้" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="คุณสามารถกลับสู่หน้าจอแก้ไขเพื่อแปลเนื้อหาตอนนี้ด้วย AI ได้ทันที"
                                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <Button Classes="reading-action primary" Command="{Binding ToggleFocusModeCommand}"
                                    Content="กลับไปหน้าแปล" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- ส่วนท้ายบท สไตล์หนังสือวรรณกรรม (Literary End-of-Chapter Navigation) -->
                    <StackPanel Spacing="24" Margin="0,0,0,32">
                        <!-- สัญลักษณ์จบบท -->
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Border Height="1" Width="36" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="· · ·" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Border Height="1" Width="36" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- แถบปุ่มเปลี่ยนตอนท้ายหน้ากระดาษ (Quiet Refined Navigation) -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <!-- ปุ่มตอนก่อนหน้า -->
                            <Button Classes="reading-action" Command="{Binding PreviousChapterCommand}" Focusable="False"
                                    HorizontalAlignment="Left" ToolTip.Tip="ตอนก่อนหน้า">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Path Data="M15,18 L9,12 L15,6" Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="ตอนก่อนหน้า" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- ปุ่มตอนถัดไป (Primary Editorial Style คุมโทนตามธีม) -->
                            <Button Grid.Column="2" Classes="reading-action primary" Command="{Binding NextChapterCommand}" Focusable="False"
                                    HorizontalAlignment="Right" ToolTip.Tip="อ่านตอนถัดไป">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="อ่านตอนถัดไป" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Path Data="M9,18 L15,12 L9,6" Stroke="{DynamicResource MainBgBrush}"
                                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- แถบควบคุมมินิมอลแบบ Auto-hide (ลอยด้านบน จางลงเมื่อเลื่อนอ่าน ปรากฏเมื่อชี้เมาส์หรืออยู่ที่บนสุด) -->
            <Border x:Name="ReadingTopBar"
                    Classes="reading-top-bar is-active"
                    VerticalAlignment="Top"
                    Background="{DynamicResource HeaderBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Height="48" Padding="16,0">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Left: ปุ่มออกจากโหมดอ่าน (Esc / F10) -->
                    <Button Command="{Binding ToggleFocusModeCommand}" Classes="ghost" Height="32" Padding="8,0"
                            ToolTip.Tip="กลับสู่หน้าจอแก้ไข (Esc หรือ F10)">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Clean 1.5px stroke line back arrow -->
                            <Path Data="M19,12 L5,12 M12,19 L5,12 L12,5"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="ออกโหมดอ่าน" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Border Classes="keycap" VerticalAlignment="Center" Margin="2,0,0,0">
                                <TextBlock Text="Esc" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Center: ชื่อตอนย่อ & ลำดับตอน -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ChapterTitleEdit}" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                   MaxWidth="400" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ReadingChapterPositionText}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: ปุ่มเปลี่ยนตอน, ขนาดอักษร, สลับธีม -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- ปุ่มตอนก่อนหน้า / ถัดไป -->
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Command="{Binding PreviousChapterCommand}" Focusable="False" Height="32" Width="32" Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    ToolTip.Tip="{Binding PrevChapterTooltipText}">
                                <Path Data="M15,18 L9,12 L15,6" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                            <Button Command="{Binding NextChapterCommand}" Focusable="False" Height="32" Width="32" Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    ToolTip.Tip="{Binding NextChapterTooltipText}">
                                <Path Data="M9,18 L15,12 L9,6" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <!-- เส้นคั่นบางๆ -->
                        <Border Height="16" Width="1" Background="{DynamicResource BorderSubtleBrush}" />

                        <!-- ปรับฟอนต์และขนาดตัวอักษร A- / A+ -->
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding AvailableEditorFonts}" SelectedItem="{Binding EditorFontFamily, Mode=TwoWay}"
                                      Width="140" Height="32" FontSize="12" VerticalAlignment="Center"
                                      ToolTip.Tip="เลือกแบบอักษร" />
                            <Button Command="{Binding DecreaseFontSizeCommand}" Content="A-" Width="32" Height="32" Padding="0"
                                    FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="ลดขนาดตัวอักษร" />
                            <TextBlock Text="{Binding EditorFontSize, StringFormat='{}{0}px'}" FontSize="12" Width="36"
                                       TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Command="{Binding IncreaseFontSizeCommand}" Content="A+" Width="32" Height="32" Padding="0"
                                    FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="เพิ่มขนาดตัวอักษร" />
                        </StackPanel>

                        <!-- เส้นคั่นบางๆ -->
                        <Border Height="16" Width="1" Background="{DynamicResource BorderSubtleBrush}" />

                        <!-- ปรับแสงและธีมในโหมดอ่าน -->
                        <Button Height="32" FontSize="12" Padding="10,0" VerticalContentAlignment="Center"
                                ToolTip.Tip="ปรับโหมดสีและความสว่างหน้าจอ">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="แสงและสี" VerticalAlignment="Center" />
                                <Path Data="M6,9 L12,15 L18,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="12" Width="220" Margin="4">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="โหมดสี (Theme)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox SelectedIndex="{Binding ThemeModeIndex}" HorizontalAlignment="Stretch" FontSize="12" Height="32">
                                                <ComboBoxItem Content="โหมดสว่าง (Light)" />
                                                <ComboBoxItem Content="โหมดมืด (Dark)" />
                                                <ComboBoxItem Content="ถนอมสายตา (Sepia)" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="ความสว่างหน้าจอ" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding BrightnessDisplayText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    Value="{Binding BrightnessLevel}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay Canvas สำหรับ Floating Drag Ghost Card และ MMB Scroll Anchor -->
        <Canvas x:Name="DragGhostCanvas" Grid.RowSpan="2" IsHitTestVisible="False" ZIndex="9999" IsVisible="False">
            <Border x:Name="DragGhostBorder" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" BoxShadow="0 4 16 0 #30000000" Opacity="0.96" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineCap="Round"
                          Width="14" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock x:Name="DragGhostText" Text="ตอนที่ 1" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="MmbScrollAnchor" Width="28" Height="28" CornerRadius="14"
                    Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    BoxShadow="0 2 8 0 #30000000" Opacity="0.95"
                    IsVisible="False">
                <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M9,9 L13,5 L17,9 M9,17 L13,21 L17,17" Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" />
                    <Ellipse Canvas.Left="11.5" Canvas.Top="11.5" Width="3" Height="3"
                             Fill="{DynamicResource TextSecondaryBrush}" />
                </Canvas>
            </Border>
        </Canvas>

        <!-- Dimming Overlay สำหรับปรับแสงหน้าจอ (Light Adjustment) -->
        <Border Grid.RowSpan="2" Background="#000000" Opacity="{Binding DimOverlayOpacity}"
                IsHitTestVisible="False" ZIndex="9990" />

        <!-- Popup สำหรับเพิ่มคำศัพท์เข้า Glossary เมื่อมีการลากคลุมคำ (Pill Blue Only, ไม่มีพื้นหลังข้าง) -->
        <Popup x:Name="GlossaryPopup" IsLightDismissEnabled="True" Placement="TopEdgeAlignedLeft">
            <Button Classes="primary" Content="เพิ่มเข้า Glossary" Click="OnAddSelectedToGlossaryClicked"
                    Height="26" FontSize="11" FontWeight="Medium" Padding="12,0"
                    CornerRadius="13"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
        </Popup>
    </Grid>
</Window>
