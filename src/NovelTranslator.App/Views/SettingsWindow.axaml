<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovelTranslator.App.ViewModels"
        xmlns:settings="using:NovelTranslator.Core.Settings"
        x:Class="NovelTranslator.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="การตั้งค่า (Settings)"
        Width="860" Height="720"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RaisedBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RaisedBgBrush}" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource MainBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="12"
            BoxShadow="0 8 32 0 #60000000" Margin="12">
        <Grid RowDefinitions="Auto, *">
            <!-- Custom Modern Titlebar -->
            <Border Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Height="40" Padding="16,0,8,0"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="การตั้งค่า (Settings)" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Click="OnCloseClicked"
                            Width="28" Height="28" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.5" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <!-- พื้นที่หลัก: แถบหมวดหมู่ซ้าย 210px + เนื้อหาขวา -->
            <Grid Grid.Row="1" RowDefinitions="*, Auto">
                <Grid ColumnDefinitions="210, *">
                    <!-- แถบเมนูด้านซ้าย (Quiet Modern Sidebar Navigation) -->
                    <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel Spacing="6">
                    <TextBlock Text="หมวดหมู่การตั้งค่า" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,8" />

                    <ListBox SelectedIndex="{Binding SelectedCategoryIndex}" Background="Transparent">
                        <ListBoxItem Padding="8,8" CornerRadius="6">
                            <Grid ColumnDefinitions="3, *">
                                <Border Width="3" Height="16" Background="#2563EB" CornerRadius="1.5"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Path Data="M12,2 A2,2 0 0,1 14,4 L14,5 L18,5 A2,2 0 0,1 20,7 L20,17 A2,2 0 0,1 18,19 L6,19 A2,2 0 0,1 4,17 L4,7 A2,2 0 0,1 6,5 L10,5 L10,4 A2,2 0 0,1 12,2 Z M9,9 A1.5,1.5 0 1,0 9,12 A1.5,1.5 0 0,0 9,9 Z M15,9 A1.5,1.5 0 1,0 15,12 A1.5,1.5 0 0,0 15,9 Z M8,15 L16,15"
                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="ปัญญาประดิษฐ์ (AI)" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Padding="8,8" CornerRadius="6">
                            <Grid ColumnDefinitions="3, *">
                                <Border Width="3" Height="16" Background="#2563EB" CornerRadius="1.5"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Path Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M8,4 L8,8 M15,10 L15,14 M10,16 L10,20"
                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="พรอมต์และหลังบ้าน" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Padding="8,8" CornerRadius="6">
                            <Grid ColumnDefinitions="3, *">
                                <Border Width="3" Height="16" Background="#2563EB" CornerRadius="1.5"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Path Data="M3,5 L21,5 A2,2 0 0,1 23,7 L23,17 A2,2 0 0,1 21,19 L3,19 A2,2 0 0,1 1,17 L1,7 A2,2 0 0,1 3,5 Z M5,8 L7,8 M9,8 L11,8 M13,8 L15,8 M17,8 L19,8 M5,11 L7,11 M9,11 L11,11 M13,11 L15,11 M17,11 L19,11 M6,15 L18,15"
                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="ปุ่มลัด (Shortkeys)" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Padding="8,8" CornerRadius="6">
                            <Grid ColumnDefinitions="3, *">
                                <Border Width="3" Height="16" Background="#2563EB" CornerRadius="1.5"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Path Data="M12,15.5 A3.5,3.5 0 1,0 12,8.5 A3.5,3.5 0 0,0 12,15.5 Z M19.4,13 A7.8,7.8 0 0,0 19.5,12 A7.8,7.8 0 0,0 19.4,11 L21.5,9.4 A0.5,0.5 0 0,0 21.6,8.7 L19.6,5.3 A0.5,0.5 0 0,0 19,5.1 L16.5,6.1 A7.9,7.9 0 0,0 14.8,5.1 L14.4,2.5 A0.5,0.5 0 0,0 13.9,2 L9.9,2 A0.5,0.5 0 0,0 9.4,2.5 L9.1,5.1 A7.9,7.9 0 0,0 7.3,6.1 L4.8,5.1 A0.5,0.5 0 0,0 4.2,5.3 L2.2,8.7 A0.5,0.5 0 0,0 2.3,9.4 L4.4,11 A7.8,7.8 0 0,0 4.3,12 A7.8,7.8 0 0,0 4.4,13 L2.3,14.6 A0.5,0.5 0 0,0 2.2,15.3 L4.2,18.7 A0.5,0.5 0 0,0 4.8,18.9 L7.3,17.9 A7.9,7.9 0 0,0 9.1,18.9 L9.4,21.5 A0.5,0.5 0 0,0 9.9,22 L13.9,22 A0.5,0.5 0 0,0 14.4,21.5 L14.8,18.9 A7.9,7.9 0 0,0 16.5,17.9 L19,18.9 A0.5,0.5 0 0,0 19.6,18.7 L21.6,15.3 A0.5,0.5 0 0,0 21.5,14.6 Z"
                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="ระบบและหน้าตา" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- พื้นที่เนื้อหาด้านขวา -->
            <Grid Grid.Column="1">
                <!-- เนื้อหาหมวด 1: AI Settings -->
                <ScrollViewer IsVisible="{Binding IsAiCategorySelected}" Padding="24,20"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
                    <StackPanel Spacing="16">
                        <!-- การเชื่อมต่อ AI -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="การเชื่อมต่อ AI" FontSize="15" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="136, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="12">
                                    <TextBlock Text="ผู้ให้บริการ" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding BackendIndex}" Height="32" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Ollama (Local)" />
                                        <ComboBoxItem Content="LM Studio (Local)" />
                                        <ComboBoxItem Content="กำหนดเอง / Cloud (OpenAI-compatible)" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Text="Base URL" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaseUrl}" Height="32" VerticalContentAlignment="Center" PlaceholderText="เช่น http://localhost:11434/v1" />

                                    <TextBlock Grid.Row="2" Text="API Key" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBox Text="{Binding ApiKey}" PasswordChar="{Binding ApiKeyPasswordChar}" Height="32" VerticalContentAlignment="Center"
                                                     PlaceholderText="เว้นว่างได้หากใช้ Ollama หรือ LM Studio ในเครื่อง" />
                                            <Button Grid.Column="1" Content="แสดง/ซ่อน" Command="{Binding ToggleApiKeyVisibilityCommand}"
                                                    Height="32" FontSize="12" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding ApiKeyErrorMessage}" IsVisible="{Binding HasApiKeyError}"
                                                   FontSize="11.5" Foreground="#E5484D" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ApiKeyInfoMessage}" IsVisible="{Binding HasApiKeyInfo}"
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                    <Button Content="ทดสอบการเชื่อมต่อและดึงรายชื่อโมเดล" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding !IsBusy}" Height="32" FontSize="13" />
                                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- โมเดล AI และโหมดเกลาคำ -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="โมเดล AI" FontSize="15" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="136, *">
                                    <TextBlock Text="เลือกหรือระบุโมเดล" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" IsEditable="True"
                                              ItemsSource="{Binding AvailableModels}" Text="{Binding ModelName, Mode=TwoWay}"
                                              LostFocus="OnModelComboBoxLostFocus"
                                              Height="32" VerticalContentAlignment="Center"
                                              PlaceholderText="เลือกจากรายการ หรือพิมพ์ชื่อโมเดล เช่น qwen2.5:7b"
                                              HorizontalAlignment="Stretch" />
                                </Grid>

                                <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,4" />
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="โหมดเกลาคำอัตโนมัติหลังแปล (AI Polish)" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="ให้ AI อ่านทวนคำแปลเทียบกับต้นฉบับเพื่อเกลาสำนวนไทยให้สละสลวยขึ้นทีละส่วน"
                                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnablePolishMode}"
                                                      OnContent="เปิด" OffContent="ปิด" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="136, *" IsVisible="{Binding EnablePolishMode}">
                                        <TextBlock Text="โมเดลเกลาคำ" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" IsEditable="True"
                                                  ItemsSource="{Binding AvailableModels}" Text="{Binding PolishModelName, Mode=TwoWay}"
                                                  LostFocus="OnModelComboBoxLostFocus"
                                                  Height="32" VerticalContentAlignment="Center"
                                                  PlaceholderText="เลือก หรือพิมพ์ชื่อโมเดล (เว้นว่างเพื่อใช้โมเดลหลัก)"
                                                  HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- พารามิเตอร์ AI ขั้นสูง -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="พารามิเตอร์ AI ขั้นสูง (LLM Parameters)" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="คืนค่าพารามิเตอร์เริ่มต้น" Command="{Binding ResetAiParametersCommand}"
                                            Height="28" FontSize="12" Padding="12,0" VerticalContentAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto, 64">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Temperature" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="0.1–0.3 แปลแม่นยำคงเส้นคงวา · 0.5–0.8 สำนวนพลิ้วไหว" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0.0" Maximum="1.2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding Temperature}" Width="144" VerticalAlignment="Center" Margin="12,0" />
                                    <TextBox Grid.Column="2" Text="{Binding Temperature}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto, 64">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Top P" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="จำกัดขอบเขตคำที่สุ่มเลือก (1.0 = ค่าเริ่มต้น ไม่ส่งเข้า JSON)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding TopP}" Width="144" VerticalAlignment="Center" Margin="12,0" />
                                    <TextBox Grid.Column="2" Text="{Binding TopP}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto, 64">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Frequency Penalty" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="ลดอาการใช้คำซ้ำซาก (0.0 = ค่าเริ่มต้น ไม่ส่งเข้า JSON)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding FrequencyPenalty}" Width="144" VerticalAlignment="Center" Margin="12,0" />
                                    <TextBox Grid.Column="2" Text="{Binding FrequencyPenalty}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, 88" RowDefinitions="Auto, Auto, Auto" RowSpacing="12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Max Tokens ต่อคำขอ" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="0 = ไม่จำกัด (ไม่ส่งค่าเข้า JSON)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding MaxTokens}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                    <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Request Timeout (วินาที)" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="เวลารอสูงสุดต่อคำขอ (10–3600 วินาที, ค่าเริ่มต้น 300)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RequestTimeoutSeconds}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                    <StackPanel Grid.Row="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="ขนาดชิ้นข้อความต่อรอบ (คำต่อ Chunk)" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="แนะนำ 500–800 คำ เพื่อให้แปลละเอียดครบถ้วน" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxChunkWords}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- เนื้อหาหมวด 2: Prompts & Pipeline Settings -->
                <ScrollViewer IsVisible="{Binding IsPipelineCategorySelected}" Padding="24,20"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
                    <StackPanel Spacing="16">
                        <!-- 1. System Prompts -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="แม่แบบคำสั่ง AI (System Prompts)" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="ตัวแปรที่รองรับ: {SourceLang}, {TargetLang}, {StyleNotes} (หากไม่ใส่ {StyleNotes} ระบบจะต่อท้ายให้อัตโนมัติ)"
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="คำสั่งหลักสำหรับแปล (System Prompt)" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="คืนค่าเริ่มต้น" Command="{Binding ResetSystemPromptCommand}"
                                                Height="28" FontSize="12" Padding="12,0" VerticalContentAlignment="Center" />
                                    </Grid>
                                    <TextBox Text="{Binding CustomSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="160" Padding="12" FontSize="12" />
                                </StackPanel>

                                <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,2" />

                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="คำสั่งสำหรับโหมดเกลาคำ (Polish System Prompt)" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="คืนค่าเริ่มต้น" Command="{Binding ResetPolishPromptCommand}"
                                                Height="28" FontSize="12" Padding="12,0" VerticalContentAlignment="Center" />
                                    </Grid>
                                    <TextBox Text="{Binding CustomPolishSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="130" Padding="12" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Context & POV -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="บริบทและมุมมองการเล่าเรื่อง (Context &amp; POV)" FontSize="15" FontWeight="SemiBold" />

                                <Grid ColumnDefinitions="*, 88">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="ย่อหน้าบริบทก่อนหน้า (Context Paragraphs)" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="ส่งย่อหน้าก่อนหน้าให้ AI อ้างอิงความต่อเนื่อง แนะนำ 2 ย่อหน้า (0 = ปิด)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ContextParagraphCount}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="ดึงบริบทข้ามตอนก่อนหน้า (Cross-Chapter Context)" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="นำท้ายตอนก่อนหน้ามาต่อเป็นบริบทเริ่มต้นของตอนใหม่เพื่อให้สำนวนต่อเนื่อง" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableCrossChapterContext}"
                                                  OnContent="เปิด" OffContent="ปิด" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="ดูบริบทล่วงหน้าจากส่วนถัดไป (Look-Ahead Context)" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="แนบย่อหน้าแรกของ Chunk ถัดไปให้ AI คาดเดาผู้พูดและเหตุการณ์ได้แม่นยำขึ้น" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableLookAheadContext}"
                                                  OnContent="เปิด" OffContent="ปิด" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, 220">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="โหมดมุมมองการเล่าเรื่อง (POV Mode)" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="ช่วยคุมสรรพนามเมื่อ Chunk นั้นมีแต่บทสนทนาหรือตัวละครอื่น" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding PovModeIndex}" Height="32" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBoxItem Content="ตรวจจับอัตโนมัติ (Auto)" />
                                        <ComboBoxItem Content="บังคับบุรุษที่ 1 (First Person)" />
                                        <ComboBoxItem Content="บังคับบุรุษที่ 3 (Third Person)" />
                                        <ComboBoxItem Content="ปิดคำแนะนำ POV (Off)" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Output Validator & Retry -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="ตัวกรองผลลัพธ์และการลองแปลซ้ำ (Output Validator &amp; Retry)" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="คืนค่าเริ่มต้น" Command="{Binding ResetValidatorSettingsCommand}"
                                            Height="28" FontSize="12" Padding="12,0" VerticalContentAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="ตัดแท็ก &lt;think&gt;...&lt;/think&gt; อัตโนมัติ" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="ซ่อนส่วนคิดวิเคราะห์ของโมเดลสาย Reasoning (เช่น DeepSeek-R1, QwQ) ออกจากคำแปล" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding StripThinkTags}"
                                                  OnContent="เปิด" OffContent="ปิด" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto, 64">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="เพดาน % ภาษาอังกฤษที่ยอมให้หลงเหลือ" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="ค่าเริ่มต้น 25% · ปรับเป็น 100% เพื่อปิดการตรวจ (เหมาะกับนิยายระบบ/LitRPG)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding MaxEnglishRatioPercent}" Width="144" VerticalAlignment="Center" Margin="12,0" />
                                    <TextBox Grid.Column="2" Text="{Binding MaxEnglishRatioPercent}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto, 64">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="จำนวนรอบลองแปลซ้ำอัตโนมัติ (Max Retries)" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="จำนวนรอบที่ให้ส่งแก้ไขเพิ่มเมื่อผลลัพธ์ไม่ผ่าน Validator (0–5 รอบ, ค่าเริ่มต้น 1)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding MaxRetryAttempts}" Width="144" VerticalAlignment="Center" Margin="12,0" />
                                    <TextBox Grid.Column="2" Text="{Binding MaxRetryAttempts}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </Grid>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="คำเกริ่นที่ต้องการตัดออกเพิ่มเติม (Custom Strip Prefixes)" FontSize="13" FontWeight="Medium" />
                                    <TextBox Text="{Binding CustomStripPrefixes}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="68" Padding="12" FontSize="12"
                                             PlaceholderText="ระบุคำขึ้นต้นบรรทัดที่ต้องการตัดทิ้ง (คั่นด้วยบรรทัดใหม่ หรือ ,) เช่น หมายเหตุผู้แปล:, Note:" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4. Glossary Extractor -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="ระบบสแกนคำศัพท์ AI (Glossary Scanner)" FontSize="15" FontWeight="SemiBold" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="สแกนและบันทึกชื่อเฉพาะเข้า Glossary อัตโนมัติหลังแปลจบตอน" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="ให้ AI สกัดชื่อคน สถานที่ และสกิลใหม่เข้า Glossary ทันทีเมื่อแปลเสร็จ พร้อมแจ้งเตือน"
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAutoGlossaryScan}"
                                                  OnContent="เปิด" OffContent="ปิด" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="136, *">
                                    <TextBlock Text="โมเดลสแกนคำศัพท์" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" IsEditable="True"
                                              ItemsSource="{Binding AvailableModels}" Text="{Binding GlossaryModelName, Mode=TwoWay}"
                                              LostFocus="OnModelComboBoxLostFocus"
                                              Height="32" VerticalContentAlignment="Center"
                                              PlaceholderText="เลือก หรือพิมพ์ชื่อโมเดล (เว้นว่างเพื่อใช้โมเดลหลัก)"
                                              HorizontalAlignment="Stretch" />
                                </Grid>

                                <Grid ColumnDefinitions="*, 88">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="จำนวนคำสูงสุดที่สแกนต่อตอน" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="ค่าเริ่มต้น 1,500 คำ · ตั้งเป็น 0 เพื่อส่งสแกนทั้งตอน" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding GlossaryScanMaxWords}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </Grid>

                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="คำสั่งสแกนคำศัพท์ (Glossary Extraction Prompt)" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="ตัวแปรที่รองรับ: {SourceText}, {TranslatedText} (คงคำขอ JSON Array ไว้เพื่อให้ดึงข้อมูลได้)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="คืนค่าเริ่มต้น" Command="{Binding ResetGlossaryPromptCommand}"
                                                Height="28" FontSize="12" Padding="12,0" VerticalContentAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                    <TextBox Text="{Binding CustomGlossaryPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="140" Padding="12" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- เนื้อหาหมวด 2: Shortkeys Settings -->
                <ScrollViewer IsVisible="{Binding IsShortkeysCategorySelected}" Padding="24,20"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
                    <StackPanel Spacing="16">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="ตั้งค่าปุ่มลัดของโปรแกรม (Shortkeys)" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="คลิกที่ปุ่มลัดแล้วกดปุ่มบนคีย์บอร์ดเพื่อบันทึกปุ่มใหม่ หรือกด ↺ เพื่อคืนค่าเริ่มต้น" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />

                                <Grid ColumnDefinitions="*, 200" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="12">
                                    <!-- 1. เริ่มแปล -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="เริ่มแปลตอนปัจจุบัน" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="แปลเฉพาะส่วนใหม่หรือที่ยังไม่ได้แปล" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Button Command="{Binding StartRecordingCommand}" CommandParameter="TranslateKey"
                                                Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="คลิกแล้วกดปุ่มบนคีย์บอร์ดเพื่อเปลี่ยนปุ่ม (Esc เพื่อยกเลิก)">
                                            <TextBlock Text="{Binding TranslateKeyDisplay}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetShortcutCommand}" CommandParameter="TranslateKey"
                                                Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="คืนค่าเริ่มต้น (Ctrl+Enter)">
                                            <Path Data="M4,12 A8,8 0 1,0 6.34,6.34 M4,4 L4,9 L9,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- 2. แปลทั้งหมด -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="แปลทุกตอนที่ยังไม่ได้แปล" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="เริ่มแปลต่อเนื่องทั้งเรื่องอัตโนมัติ" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Button Command="{Binding StartRecordingCommand}" CommandParameter="TranslateAllKey"
                                                Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="คลิกแล้วกดปุ่มบนคีย์บอร์ดเพื่อเปลี่ยนปุ่ม (Esc เพื่อยกเลิก)">
                                            <TextBlock Text="{Binding TranslateAllKeyDisplay}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetShortcutCommand}" CommandParameter="TranslateAllKey"
                                                Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="คืนค่าเริ่มต้น (Ctrl+Shift+Enter)">
                                            <Path Data="M4,12 A8,8 0 1,0 6.34,6.34 M4,4 L4,9 L9,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- 3. ค้นหาและแทนที่ -->
                                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                        <TextBlock Text="เปิดหน้าต่างค้นหาและแทนที่คำ" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Button Command="{Binding StartRecordingCommand}" CommandParameter="SearchReplaceKey"
                                                Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="คลิกแล้วกดปุ่มบนคีย์บอร์ดเพื่อเปลี่ยนปุ่ม (Esc เพื่อยกเลิก)">
                                            <TextBlock Text="{Binding SearchReplaceKeyDisplay}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetShortcutCommand}" CommandParameter="SearchReplaceKey"
                                                Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="คืนค่าเริ่มต้น (Ctrl+F)">
                                            <Path Data="M4,12 A8,8 0 1,0 6.34,6.34 M4,4 L4,9 L9,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- 4. บันทึก -->
                                    <StackPanel Grid.Row="3" VerticalAlignment="Center">
                                        <TextBlock Text="บันทึกข้อความตอนปัจจุบัน" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Button Command="{Binding StartRecordingCommand}" CommandParameter="SaveKey"
                                                Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="คลิกแล้วกดปุ่มบนคีย์บอร์ดเพื่อเปลี่ยนปุ่ม (Esc เพื่อยกเลิก)">
                                            <TextBlock Text="{Binding SaveKeyDisplay}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetShortcutCommand}" CommandParameter="SaveKey"
                                                Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="คืนค่าเริ่มต้น (Ctrl+S)">
                                            <Path Data="M4,12 A8,8 0 1,0 6.34,6.34 M4,4 L4,9 L9,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- 5. เต็มจอ -->
                                    <StackPanel Grid.Row="4" VerticalAlignment="Center">
                                        <TextBlock Text="สลับโหมดเต็มหน้าจอ (Full Screen)" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                    <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Button Command="{Binding StartRecordingCommand}" CommandParameter="FullScreenKey"
                                                Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="คลิกแล้วกดปุ่มบนคีย์บอร์ดเพื่อเปลี่ยนปุ่ม (Esc เพื่อยกเลิก)">
                                            <TextBlock Text="{Binding FullScreenKeyDisplay}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetShortcutCommand}" CommandParameter="FullScreenKey"
                                                Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="คืนค่าเริ่มต้น (F11)">
                                            <Path Data="M4,12 A8,8 0 1,0 6.34,6.34 M4,4 L4,9 L9,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- 6. โหมดโฟกัส -->
                                    <StackPanel Grid.Row="5" VerticalAlignment="Center">
                                        <TextBlock Text="สลับโหมดโฟกัสไร้สิ่งรบกวน" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                    <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Button Command="{Binding StartRecordingCommand}" CommandParameter="FocusModeKey"
                                                Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="คลิกแล้วกดปุ่มบนคีย์บอร์ดเพื่อเปลี่ยนปุ่ม (Esc เพื่อยกเลิก)">
                                            <TextBlock Text="{Binding FocusModeKeyDisplay}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetShortcutCommand}" CommandParameter="FocusModeKey"
                                                Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="คืนค่าเริ่มต้น (F10)">
                                            <Path Data="M4,12 A8,8 0 1,0 6.34,6.34 M4,4 L4,9 L9,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- 7. ตอนก่อนหน้า -->
                                    <StackPanel Grid.Row="6" VerticalAlignment="Center">
                                        <TextBlock Text="ไปยังตอนก่อนหน้า" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                    <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Button Command="{Binding StartRecordingCommand}" CommandParameter="PrevChapterKey"
                                                Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="คลิกแล้วกดปุ่มบนคีย์บอร์ดเพื่อเปลี่ยนปุ่ม (Esc เพื่อยกเลิก)">
                                            <TextBlock Text="{Binding PrevChapterKeyDisplay}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetShortcutCommand}" CommandParameter="PrevChapterKey"
                                                Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="คืนค่าเริ่มต้น (Alt+Left)">
                                            <Path Data="M4,12 A8,8 0 1,0 6.34,6.34 M4,4 L4,9 L9,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- 8. ตอนถัดไป -->
                                    <StackPanel Grid.Row="7" VerticalAlignment="Center">
                                        <TextBlock Text="ไปยังตอนถัดไป" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                    <Grid Grid.Row="7" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Button Command="{Binding StartRecordingCommand}" CommandParameter="NextChapterKey"
                                                Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="คลิกแล้วกดปุ่มบนคีย์บอร์ดเพื่อเปลี่ยนปุ่ม (Esc เพื่อยกเลิก)">
                                            <TextBlock Text="{Binding NextChapterKeyDisplay}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetShortcutCommand}" CommandParameter="NextChapterKey"
                                                Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="คืนค่าเริ่มต้น (Alt+Right)">
                                            <Path Data="M4,12 A8,8 0 1,0 6.34,6.34 M4,4 L4,9 L9,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- 9. แถบข้าง -->
                                    <StackPanel Grid.Row="8" VerticalAlignment="Center">
                                        <TextBlock Text="ซ่อน/แสดงแถบรายการตอนด้านซ้าย" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                    <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Button Command="{Binding StartRecordingCommand}" CommandParameter="ToggleSidebarKey"
                                                Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="คลิกแล้วกดปุ่มบนคีย์บอร์ดเพื่อเปลี่ยนปุ่ม (Esc เพื่อยกเลิก)">
                                            <TextBlock Text="{Binding ToggleSidebarKeyDisplay}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ResetShortcutCommand}" CommandParameter="ToggleSidebarKey"
                                                Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="คืนค่าเริ่มต้น (Ctrl+B)">
                                            <Path Data="M4,12 A8,8 0 1,0 6.34,6.34 M4,4 L4,9 L9,9" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Grid>

                                <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,8,0,4" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{Binding RecordingPromptText}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" IsVisible="{Binding IsRecording}" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Content="คืนค่าเริ่มต้นทั้งหมด" Command="{Binding ResetAllShortcutsCommand}"
                                            Height="32" FontSize="12" Padding="14,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            ToolTip.Tip="คืนค่าปุ่มลัดทั้งหมดเป็นค่าเริ่มต้นของโปรแกรม" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- เนื้อหาหมวด 3: System & Appearance -->
                <ScrollViewer IsVisible="{Binding IsSystemCategorySelected}" Padding="24,20"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
                    <StackPanel Spacing="16">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="แบบอักษรและขนาดตัวหนังสือ" FontSize="15" FontWeight="SemiBold" />

                                <!-- เลือกฟอนต์ -->
                                <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto" RowSpacing="12">
                                    <TextBlock Text="แบบอักษร (Font)" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding AvailableEditorFonts}" SelectedItem="{Binding EditorFontFamily, Mode=TwoWay}"
                                                  Height="32" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="+ เพิ่มฟอนต์" Classes="ghost"
                                                Click="OnUploadFontClicked"
                                                Height="32" Padding="12,0" VerticalContentAlignment="Center"
                                                ToolTip.Tip="อัปโหลดไฟล์ฟอนต์ (.ttf หรือ .otf) จากเครื่อง" />
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="ขนาดตัวอักษร" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, 64">
                                        <Slider Minimum="14" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding EditorFontSize}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="1" Text="{Binding EditorFontSize}" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <!-- รายการฟอนต์ที่อัปโหลดเอง + ปุ่มลบ -->
                                <StackPanel Spacing="8" IsVisible="{Binding HasUploadedCustomFonts}">
                                    <TextBlock Text="ฟอนต์ที่อัปโหลดเอง (.ttf / .otf)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding UploadedCustomFonts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="settings:CustomFontInfo">
                                                <Border Background="{DynamicResource MainBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,4,6,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        <Button Content="ลบ" Classes="ghost"
                                                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).DeleteCustomFontCommand}"
                                                                CommandParameter="{Binding}"
                                                                FontSize="11" Height="22" Padding="8,0" VerticalContentAlignment="Center"
                                                                Foreground="{DynamicResource TextMutedBrush}"
                                                                ToolTip.Tip="ลบฟอนต์นี้ออกจากโปรแกรม" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="{Binding FontStatusMessage}" IsVisible="{Binding HasFontStatusMessage}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                                <!-- Live Preview Box -->
                                <TextBlock Text="ตัวอย่างการแสดงผล (Preview)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
                                <Border Background="{DynamicResource MainBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="The quick brown fox&#x0a;jumps over the lazy dog."
                                                   TextWrapping="Wrap"
                                                   LineHeight="34"
                                                   FontFamily="{Binding CurrentFontFamily}" FontSize="{Binding EditorFontSize}" />
                                        <TextBlock Text="นิยายบทที่หนึ่ง: ท้องฟ้ายามราตรี&#x0a;พร่างพราวด้วยแสงดวงดาราอันไกลโพ้น..."
                                                   TextWrapping="Wrap"
                                                   LineHeight="34"
                                                   FontFamily="{Binding CurrentFontFamily}" FontSize="{Binding EditorFontSize}" />
                                    </StackPanel>
                                </Border>

                                <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,6" />

                                <TextBlock Text="การปรับแสงและโหมดสี (Light Adjustment)" FontSize="15" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto" RowSpacing="12">
                                    <TextBlock Text="โหมดสี (Theme)" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeModeIndex}" Height="32" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="โหมดสว่าง (Light)" />
                                        <ComboBoxItem Content="โหมดมืด (Dark)" />
                                        <ComboBoxItem Content="ถนอมสายตา (Sepia)" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Text="ความสว่างหน้าจอ" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, 56">
                                        <Slider Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding BrightnessLevel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding BrightnessLevel, StringFormat='{}{0:0}%'}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                </Grid>

                                <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,6" />

                                <TextBlock Text="การทำงานของระบบ (System Behavior)" FontSize="15" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*, 220" RowDefinitions="Auto, Auto, Auto" RowSpacing="12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="รูปแบบการแสดงผลคำแปล" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="เลือกว่าจะให้คำแปลปรากฏทีละส่วนเมื่อแปลจบ Chunk หรือสตรีมสดทีละคำ" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding TranslationAppearanceIndex}" Height="32" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBoxItem Content="ทีละส่วน (Per Chunk)" />
                                        <ComboBoxItem Content="ทีละคำ (Word by Word)" />
                                    </ComboBox>

                                    <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="หน่วงเวลาบันทึกอัตโนมัติ (วินาที)" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="ระยะเวลารอหลังจากพิมพ์ข้อความเพื่อบันทึกอัตโนมัติลงฐานข้อมูล" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AutoSaveDelaySeconds}" Height="32" Width="88" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                    <StackPanel Grid.Row="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="ความไวการเลื่อนด้วยเมาส์กลาง (MMB)" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="ปรับความเร็วในการเลื่อนหน้าจอเมื่อกดปุ่มเมาส์กลาง (0.2x – 5.0x)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*, 48" VerticalAlignment="Center">
                                        <Slider Minimum="0.2" Maximum="5.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding MmbScrollSensitivity}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding MmbScrollSensitivity, StringFormat='{}{0:0.0}x'}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- แถบปุ่มบันทึกด้านล่าง -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="บันทึกการตั้งค่าเพื่อนำไปใช้กับงานแปลทันที" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="ยกเลิก" Classes="ghost" Click="OnCancelClicked"
                            Height="32" Padding="16,0" VerticalContentAlignment="Center" />
                    <Button Content="บันทึกการตั้งค่า" Classes="primary" Command="{Binding SaveAndCloseCommand}"
                            Height="32" Padding="20,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
